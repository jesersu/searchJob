{
  "name": "searchjob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "jobs": "node --disable-warning=ExperimentalWarning --import tsx src/cli/index.ts",
    "search": "node -e \"console.error('Usa: pnpm jobs <archivo-de-rol>  (pnpm search es un comando propio de pnpm)'); process.exit(1)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
